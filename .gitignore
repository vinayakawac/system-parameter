*.key
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
id_rsa*
id_ed25519*
*.token
*.secret
*.secrets
*secret*.json
credentials*.json
service-account*.json
*.credentials
secrets/
.secrets/
.aws/
.azure/
.gcloud/
.docker/
.vercel/
.netlify/
*.local
*.local.*

